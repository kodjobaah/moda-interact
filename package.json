{
  "name": "moda-interact",
  "private": true,
  "scripts": {
    "shopify": "node scripts/shopify.mjs",
    "shopify:ngrok": "ngrok http 50620",
    "shopify:dev": "node scripts/shopify-dev.mjs",
    "shopify:dev:cloud": "node scripts/shopify-dev-cloud.mjs",
    "build": "npm run prisma:generate && react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node --import ./observability.mjs ./node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "migrate": "npm run prisma:migrate:deploy",
    "seed": "npm run prisma:seed",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "prisma:validate": "prisma validate --schema database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "prisma:status": "prisma migrate status --schema database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "prisma:seed": "node database/prisma/seed.mjs",
    "test:merchant-request:unit": "vitest run tests/unit/merchant-request-context.test.ts tests/unit/services/shop.service.test.ts tests/unit/routes/auth-catchall.test.ts tests/unit/merchant-route-access-policy.test.ts",
    "test:merchant-request:router": "vitest run tests/integration/merchant-request-context-router.test.ts",
    "test:merchant-request:postgres": "MODA_MERCHANT_REQUEST_POSTGRES=1 vitest run tests/integration/merchant-shop-bootstrap.postgres.test.ts",
    "test:recovery-readers:unit": "vitest run tests/unit/recovery-read-context.test.ts tests/unit/recovery-reader-observability.test.ts tests/unit/recovery-detail-readers.test.ts tests/unit/recovery-detail-route.test.ts tests/unit/recovery-list-route.test.ts tests/unit/recovery-overview.test.ts tests/unit/recovery-cohort-readers.test.ts tests/unit/arch040-shopify-command.test.ts tests/unit/arch040-shopify-http.test.ts tests/unit/arch047-shopify-follow-up-catalogue.test.ts tests/unit/arch047-shopify-follow-up-sender.test.ts",
    "test:recovery-readers:postgres": "MODA_RECOVERY_DETAIL_POSTGRES=1 vitest run tests/integration/recovery-detail-query-plans.test.ts",
    "test:merchant-support:unit": "vitest run tests/unit/merchant-support-service.test.ts tests/unit/merchant-support-route.test.ts tests/unit/merchant-support-observability.test.ts tests/unit/merchant-support-recovery-i18n.test.ts tests/unit/merchant-support-batch-ui.test.tsx",
    "test:merchant-support:postgres": "MODA_DISPOSABLE_INTEGRATION=1 vitest run tests/integration/merchant-support.postgres.test.ts",
    "test:merchant-settings:unit": "vitest run tests/unit/settings-read-context.test.ts tests/unit/merchant-settings-observability.test.ts tests/unit/recovery-policy-save.test.ts tests/unit/recovery-policy-snapshot.test.ts tests/unit/settings-save-recovery-route.test.ts tests/unit/merchant-settings-action.test.ts tests/unit/ai-response-delay-loader.test.ts tests/unit/ai-response-delay.test.ts tests/unit/store-category-selection.test.ts",
    "test:merchant-settings:postgres": "MODA_DISPOSABLE_INTEGRATION=1 MODA_SETTINGS_POSTGRES=1 vitest run tests/integration/merchant-settings-writes.postgres.test.ts tests/integration/store-category-lifecycle.postgres.test.ts tests/integration/shopify-recovery-discounts.postgres.integration.test.ts tests/integration/store-category-selection.postgres.integration.test.ts tests/integration/merchant-feature-preferences.test.ts",
    "test:merchant-knowledge:unit": "vitest run tests/unit/merchant-knowledge-actions.test.ts tests/unit/merchant-knowledge-read-model.test.ts tests/unit/merchant-knowledge-entitlement.test.ts tests/unit/merchant-knowledge-upload.test.ts tests/unit/merchant-knowledge-observability.test.ts tests/unit/merchant-knowledge-queue.test.ts tests/unit/merchant-knowledge-section.test.tsx tests/unit/merchant-knowledge-upload-form.test.tsx tests/unit/merchant-knowledge-read-context.test.ts tests/unit/merchant-knowledge-ordering.test.ts tests/unit/merchant-knowledge-r2-diagnostics.test.ts",
    "test:merchant-knowledge:router": "vitest run tests/integration/merchant-knowledge-router.test.tsx",
    "test:merchant-knowledge:postgres": "MODA_DISPOSABLE_INTEGRATION=1 vitest run tests/integration/merchant-knowledge-source-lifecycle.integration.test.ts tests/integration/merchant-knowledge-upload.integration.test.ts tests/integration/merchant-knowledge-ordering.postgres.test.ts tests/integration/merchant-knowledge-finalization.postgres.test.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@modainteract/moda-interact-shared": "3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "bullmq": "^6.3.1",
    "d3": "^7.9.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.31",
    "pg": "^8.23.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "prisma-generator-plantuml-erd": "^1.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "4.1.11"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "kwadwoadomafriyie",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/client@5.19.0": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.12": true
  }
}
